# behavior-transform.io - environment template
# Copy to .env and fill in values. Never commit .env.

# Override the tools directory (optional)
# BEHAVIOR_TRANSFORM_TOOLS=C:/dev/state/behavior-transform.io/tools

# Workstation root scope override (optional)
# WARDEN_WORKSTATION_ROOT=C:/dev/state

# IO channel (ops | research | academic)
# WARDEN_IO_CHANNEL=ops
